# NOTE: This is a template. Run ./setup-gui.sh (or ./install.sh) to install with
# the correct absolute paths — both Exec and Icon are rewritten with $SCRIPT_DIR
# (helpers/gui-setup.sh) so the icon renders without depending on the user's
# icon theme (matters on KDE Breeze / Mint-Y / MATE / XFCE etc., where Adwaita
# symbolic names like auth-fingerprint-symbolic don't resolve and fall back to
# the blank glyph). Translations of Name/Comment/Keywords live here only.
Exec=python3 cs9711-manager.py
Icon=assets/cs9711-manager.svg
Terminal=false
Categories=Settings;HardwareSettings;System;
Keywords=fingerprint;scanner;cs9711;biometric;chipsailing;
