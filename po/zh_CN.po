#: cs9711-manager.py:2009
#, python-brace-format
msgid ""
"Missing {libraries} — a system library the driver was built against was "
"upgraded. Rebuild to relink against the new one."
msgstr ""
"缺少 {libraries} — 构建驱动时所依赖的系统库已升级。请重新构建，以链接到新版"
"本。"

